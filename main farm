task.spawn(function()
    while task.wait(1) do
        local currentCash = getCash()
        local earned = (initialCash > 0) and (currentCash - initialCash) or 0
        local secs = math.floor(tick() - stats.startTime)
        local mins = math.floor(secs / 60)
        local hrs  = math.floor(mins / 60)
        local timeStr = hrs > 0
            and string.format("%dh %dm", hrs, mins % 60)
            or  string.format("%dm %ds", mins, secs % 60)

        StatCashVal.Text   = "$" .. tostring(currentCash)
        if earned > 0 then
            StatEarnedVal.Text = "+$" .. tostring(earned)
            StatEarnedVal.TextColor3 = Color3.fromRGB(85, 255, 127)
        elseif earned < 0 then
