            StatEarnedVal.TextColor3 = Color3.fromRGB(255, 80, 80)
        else
            StatEarnedVal.Text = "$0"
            StatEarnedVal.TextColor3 = Color3.fromRGB(180, 180, 180)
        end
        StatTimeVal.Text   = timeStr
    end
end)

