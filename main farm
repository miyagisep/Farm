local function buyKnife()
    local existing = getKnife()
    if existing then
        if existing.Parent ~= character then
            pcall(function() humanoid:EquipTool(existing) end)
            task.wait(0.3)
        end
        return true
    end

    rootPart.CFrame = KNIFE_POSITION + Vector3.new(0, 3, 0)
    task.wait(0.8)

    existing = getKnife()
    if existing then
        if existing.Parent ~= character then
            pcall(function() humanoid:EquipTool(existing) end)
            task.wait(0.3)
        end
        return true
    end

    local closestCD, closestDist = nil, math.huge
    for _, v in pairs(Workspace:GetDescendants()) do
        if v:IsA("ClickDetector") then
            local pos = getSafePosition(v.Parent)
            if pos then
                local dist = (pos - rootPart.Position).Magnitude
                if dist < closestDist then closestDist = dist; closestCD = v end
            end
        end
    end
    if closestCD and closestDist < 15 then
        fireclickdetector(closestCD)
    else
        warn("No ClickDetector found near knife position!"); return false
    end

    local attempts = 0
    repeat
        task.wait(0.3)
        attempts = attempts + 1
        if getKnife() ~= nil then break end
    until attempts > 20

    local knife = getKnife()
    if knife then
        if knife.Parent ~= character then
            pcall(function() humanoid:EquipTool(knife) end)
            task.wait(0.4)
        end
        return true
    else
        warn("Knife not found after purchase attempt.")
        return false
    end
end

