        if not plr or not plr.UserId then return false end
        for _, id in pairs(modIds) do
            if plr.UserId == id then
                if not detectedPlayers[plr.UserId] then
                    detectedPlayers[plr.UserId] = true
                    doServerHop()
                end
                return true
