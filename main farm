local function autoRobCashiers()
    if farmRunning then return end
    farmRunning = true

    while autoRobEnabled do
        pcall(function()
            if player.Character and player.Character.BodyEffects and player.Character.BodyEffects.Cuff.Value == true then
                UnJail()
                task.wait(1)
            end
        end)

        if not rootPart or not rootPart.Parent then
            task.wait(1)
            pcall(updateCharacterReferences)
            task.wait(1)
        else
            local currentTool = nil
            if selectedWeapon == "Knife" then
                currentTool = getKnife()
                if not currentTool then
                    buyKnife()
                    currentTool = getKnife()
                    if not currentTool then task.wait(2) end
                end
            elseif selectedWeapon == "Combat" then
                currentTool = getCombat()
                if not currentTool then
                    buyCombat()
                    currentTool = getCombat()
                    if not currentTool then task.wait(2) end
                end
            end

            if not currentTool then task.wait(1) else
                if currentTool.Parent ~= character then 
                    humanoid:EquipTool(currentTool)
                    task.wait(0.2) 
                end

                if countAliveCashiers() == 0 then
                    if notifyEnabled then
                        local currentCash = getCash()
                        local earned = math.max(0, currentCash - initialCash)
                        sendWebhook("No Cashiers Available", string.format("**Wallet:** $%s | **Earned:** $%s", tostring(currentCash), tostring(earned)), 16753920)
                    end
                    repeat
                        task.wait(3)
                        pcall(function()
                            if rootPart and rootPart.Parent then
                                rootPart.CFrame = CFrame.new(
                                    math.random(-450000000, -100000000),
                                    math.random(100000000, 450000000),
                                    math.random(-450000000, -100000000)
                                )
                            else
                                updateCharacterReferences()
                            end
                        end)
                    until countAliveCashiers() > 0 or not autoRobEnabled

                    if autoRobEnabled then
                        pcall(updateCharacterReferences)
                        task.wait(1)

                        if selectedWeapon == "Knife" then
                            currentTool = getKnife()
                        else
                            currentTool = getCombat()
                        end
                        if currentTool and currentTool.Parent ~= character then
                            humanoid:EquipTool(currentTool)
                            task.wait(0.2)
                        end
                    end
                else
                    local Target = getTarget()
                    if not Target or not Target:FindFirstChild("Humanoid") or Target.Humanoid.Health <= 0 then
                        task.wait(0.5)
                    else
                        local targetHum = Target:FindFirstChild("Humanoid")
                        local lastHealth = targetHum and targetHum.Health or 0

                        repeat
                            task.wait(0.05)
                            pcall(function()
                                if selectedWeapon == "Knife" then currentTool = getKnife() else currentTool = getCombat() end
                                if not currentTool then return end
                                if not Target or not Target.Parent then return end
                                local head = Target:FindFirstChild("Head")
                                if not head then return end
                                rootPart.CFrame = head.CFrame * CFrame.new(0, -2.5, 2)
                                if currentTool.Parent ~= character then
                                    humanoid:EquipTool(currentTool)
                                end
                                currentTool:Activate()
                            end)

                            targetHum = Target and Target:FindFirstChild("Humanoid")
                            if targetHum then lastHealth = targetHum.Health end
                        until not autoRobEnabled
                            or not Target
                            or not Target.Parent
                            or not targetHum
                            or targetHum.Health <= 0

                        if Target and Target:FindFirstChild("Humanoid") and Target.Humanoid.Health <= 0 then
                            stats.cashiersRobbed = stats.cashiersRobbed + 1

                            if notifyRobsEnabled and stats.cashiersRobbed % 10 == 0 then
                                sendWebhook(
                                    string.format("🏦 %d Cashiers Robbed!", stats.cashiersRobbed),
                                    "",
                                    9699539
                                )
                            end

                            task.wait(0.3)
                            local collectTime = tick()
                            while tick() - collectTime < 4 do
                                pcall(function()
                                    for _, v in pairs(Workspace.Ignored.Drop:GetDescendants()) do
                                        if v:IsA("ClickDetector") and v.Parent and v.Parent.Name:find("Money") then
                                            if (v.Parent.Position - rootPart.Position).Magnitude <= 25 then
                                                fireclickdetector(v)
                                            end
                                        end
                                    end
                                end)
                                task.wait(0.05)
                            end
                        end

                        task.wait(0.1)
                    end
                end
            end
        end
    end

    farmRunning = false
end

